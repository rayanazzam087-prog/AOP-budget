# Copy to .env and fill in. .env is git-ignored: never commit your key.

# openai = any OpenAI-compatible API (OpenAI, Gemini, Groq, OpenRouter, Ollama ...)
# anthropic = Claude;  mock = offline fake model for testing
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Leave empty for OpenAI. Examples:
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:    https://api.groq.com/openai/v1
#   Ollama:  http://localhost:11434/v1
LLM_BASE_URL=

# Model used for the answer judge and the reward-model scorer (defaults to LLM_MODEL)
JUDGE_MODEL=

# wikipedia (free, default) | tavily | serper | mock
SEARCH_BACKEND=wikipedia
# Wikipedia asks API users to identify themselves: put your e-mail here
SEARCH_CONTACT=
TAVILY_API_KEY=
SERPER_API_KEY=
